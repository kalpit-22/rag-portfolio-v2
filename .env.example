# --- API KEYS ---
# Required for Gemini 2.5 Flash and Embeddings
GOOGLE_API_KEY="your-google-api-key-here"

# Required for Reranking
COHERE_API_KEY="your-cohere-api-key-here"

# Required for Vector Database and Sparse Encoder Inference
PINECONE_API_KEY="your-pinecone-api-key-here"

# (Optional) Required if you switch back to DeepSeek instead of Gemini
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# --- LANGSMITH OBSERVABILITY ---
# Enables tracing in LangChain for LLMOps
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="portfolio-rag"
